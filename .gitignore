# AIoT-Edge Project - Gitignore

# Generated ML model files (regenerate with: python3 ml\run_training.py)
ml/models/*.tflite
ml/models/metadata.json
ml/models/labels.txt
ml/models/nn_weights.h
ml/models/evaluation.json
ml/models/wake_word_model.c
ml/models/wake_word_model.h
__pycache__/
.pytest_cache/
.test-tmp/
tests/runtime/*
!tests/runtime/.gitkeep

# Build outputs (build with: idf.py build)
*.elf
*.bin
*.hex
build/
build-features/
baseline-cmake-build/
sdkconfig
sdkconfig.old
sdkconfig.features

# Environment-specific
.idea/
.vscode/

# Sensitive data (never commit!)
*.pem
*.key
*.crt
*.p12

# IDE files
*.swp
*.sln
*.sln.*.filters
*.sln.*.vcxuser

# OS generated
Thumbs.db
Desktop.ini
node_modules/
