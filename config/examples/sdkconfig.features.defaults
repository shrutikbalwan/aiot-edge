# Compile-validation profile. Values are examples and contain no secrets.
CONFIG_AIOT_SIMULATION=y
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_AIOT_BLE_ENABLED=y
CONFIG_AIOT_WIFI_ENABLED=y
CONFIG_AIOT_MQTT_ENABLED=y
CONFIG_AIOT_OTA_ENABLED=y
CONFIG_AIOT_COMMANDS_ENABLED=y
CONFIG_AIOT_MQTT_BROKER_URI="mqtts://broker.example:8883"
CONFIG_AIOT_MQTT_USERNAME="compile-user"
CONFIG_AIOT_DEVICE_ID="compile-check"
